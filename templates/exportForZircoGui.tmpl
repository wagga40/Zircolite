var attack = [
	{% for elem in data -%}
		{% for tag in elem["tags"] -%}
			{% if ".t" in tag -%}
	[{{ tag|replace("attack.", "")|upper|tojson }}, {{ elem["title"]|tojson }}],
			{% endif -%}
		{% endfor -%}
	{% endfor -%}
];

var tags = [{% for elem in data %}{% for tag in elem["tags"] %}{% if ".t" in tag %}
	{{ tag|replace("attack.", "")|upper|tojson }},{% endif %}{% endfor %}{% endfor %}
];

