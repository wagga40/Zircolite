# PyInstaller
dist/

# The test fixtures are real sample logs, and the end-to-end tests that read
# them exist precisely because synthetic dicts let silent ingestion bugs
# through. The blanket *.evtx / *.log rules above are for user data.
!tests/fixtures/
!tests/fixtures/**

# Same reasoning for the external scenario harness: its inputs are sample
# .evtx and .log files, and a scenario without its input is not a test.
# `results` above still covers what a run writes.
!tests/external/
!tests/external/**
tests/external/**/__pycache__/
